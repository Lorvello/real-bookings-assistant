# Frontend (Vite) environment — public values only (these are bundled into the
# client, so NEVER put secrets here). Copy to .env and fill in. The real .env is
# git-ignored; server secrets live as Supabase edge-function secrets, not here.
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_WHATSAPP_NUMBER=+31600000000

# Public capability and contract claims are fail-closed. Leave Voiceflow empty
# to omit the support-chat widget and its FAQ claim. Every boolean below must
# remain false unless that exact public promise is provisioned or contracted.
# Only the exact lowercase value `true` enables a claim.
VITE_VOICEFLOW_PROJECT_ID=
VITE_WHATSAPP_NUMBER_PROVISIONING_ENABLED=false
VITE_ENTERPRISE_PROFESSIONAL_SUITE_CONTRACTED=false
VITE_ENTERPRISE_PREMIUM_SUPPORT_CONTRACTED=false
VITE_ENTERPRISE_ADVANCED_PERMISSION_HIERARCHIES_ENABLED=false
VITE_ENTERPRISE_UNLIMITED_USERS_CONTRACTED=false
VITE_ENTERPRISE_CUSTOM_BRANDED_WHATSAPP_API_ENABLED=false
VITE_ENTERPRISE_VERIFIED_WHATSAPP_ACCOUNT_GUARANTEED=false
VITE_ENTERPRISE_VOICE_ROUTING_ENABLED=false
VITE_ENTERPRISE_OMNICHANNEL_MESSAGING_ENABLED=false
VITE_ENTERPRISE_REPUTATION_MANAGEMENT_ENABLED=false
VITE_ENTERPRISE_99_9_UPTIME_SLA_CONTRACTED=false
VITE_ENTERPRISE_GUARANTEED_RESPONSE_TIMES_CONTRACTED=false
VITE_ENTERPRISE_CONTACT_RESPONSE_WITHIN_24_HOURS_STAFFED=false
VITE_ENTERPRISE_DEDICATED_MANAGER_STAFFED=false
VITE_ENTERPRISE_WHITE_GLOVE_ONBOARDING_STAFFED=false
VITE_ENTERPRISE_INTEGRATION_CONSULTING_PROVISIONED=false
